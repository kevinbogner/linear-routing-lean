import LinearRouting.FiniteKrausFixedState
import LinearRouting.FiniteKrausReindex
import LinearRouting.CrossedChannels

/-!
# Canonical realization of a raw one-round routing protocol

The raw protocol interface records a global first-round channel and an exact
equality identifying its action with the supplied mixed resource and local
channels.  This file constructs that channel explicitly.  It appends the
fixed resource, changes to the product resource basis, applies the input
regrouping, applies Alice's and Bob's channels in tensor product, and finally
applies the crossed-output regrouping.
-/

namespace LinearRouting

open Matrix
open scoped BigOperators ComplexOrder Kronecker

universe uX uY uKA uKB uRA uRB

/-- Change the appended standard `Fin (l*r)` resource carrier to its explicit
`Fin l × Fin r` product carrier without changing the input qubit. -/
def oneRoundRoutingResourceProductEquiv {l r : ℕ} :
    (Fin 2 × Fin (l * r)) ≃ (Fin 2 × (Fin l × Fin r)) :=
  (Equiv.refl (Fin 2)).prodCongr finProdFinEquiv.symm

/-- Reindexing the fixed-resource tensor along
`oneRoundRoutingResourceProductEquiv` produces the explicit product resource
matrix used by the raw protocol model. -/
theorem reindex_oneRoundRoutingResourceProductEquiv_kronecker
    {l r : ℕ} (rhoLR : DensityMatrix (l * r))
    (Q : Matrix (Fin 2) (Fin 2) ℂ) :
    Matrix.reindex oneRoundRoutingResourceProductEquiv
        oneRoundRoutingResourceProductEquiv (Q ⊗ₖ rhoLR.val) =
      Q ⊗ₖ productMatrixOfReindexed rhoLR.val := by
  rfl

/-- Kraus-index carrier of the canonical global channel.  The factors are,
in order, the fixed-state purification environment, two input relabelings,
the two local Kraus environments, and the final output relabeling. -/
abbrev OneRoundRoutingCanonicalGlobalKraus
    (KA : Type uKA) (KB : Type uKB) (l r : ℕ) :=
  ((((Fin (l * r) × Fin 1) × Fin 1) × (KA × KB)) × Fin 1)

/-- The canonical global finite Kraus channel generated by an arbitrary mixed
resource and arbitrary local first-round channels. -/
noncomputable def oneRoundRoutingCanonicalGlobalChannel
    {X : Type uX} {Y : Type uY}
    {KA : Type uKA} {KB : Type uKB} [Fintype KA] [Fintype KB]
    {l r aKeep aToB bKeep bToA : ℕ}
    (rhoLR : DensityMatrix (l * r))
    (alice : X → FiniteKrausChannel KA (Fin 2 × Fin l)
      (Fin aKeep × Fin aToB))
    (bob : Y → FiniteKrausChannel KB (Fin r)
      (Fin bKeep × Fin bToA))
    (x : X) (y : Y) :
    FiniteKrausChannel
      (OneRoundRoutingCanonicalGlobalKraus KA KB l r)
      (Fin 2)
      ((Fin aKeep × Fin bToA) × (Fin bKeep × Fin aToB)) :=
  (FiniteKrausChannel.reindex oneRoundRoutingOutputRegroup).comp
    (((alice x).tensor (bob y)).comp
      ((FiniteKrausChannel.reindex oneRoundRoutingInputRegroup).comp
        ((FiniteKrausChannel.reindex
          oneRoundRoutingResourceProductEquiv).comp
          (FiniteKrausChannel.appendFixedState rhoLR))))

/-- The canonical global channel acts exactly as the realized-output matrix
in the raw one-round routing model, on every complex input matrix. -/
theorem oneRoundRoutingCanonicalGlobalChannel_action
    {X : Type uX} {Y : Type uY}
    {KA : Type uKA} {KB : Type uKB} [Fintype KA] [Fintype KB]
    {l r aKeep aToB bKeep bToA : ℕ}
    (rhoLR : DensityMatrix (l * r))
    (alice : X → FiniteKrausChannel KA (Fin 2 × Fin l)
      (Fin aKeep × Fin aToB))
    (bob : Y → FiniteKrausChannel KB (Fin r)
      (Fin bKeep × Fin bToA))
    (x : X) (y : Y) (Q : Matrix (Fin 2) (Fin 2) ℂ) :
    (oneRoundRoutingCanonicalGlobalChannel rhoLR alice bob x y).action Q =
      oneRoundRoutingRealizedOutputMatrix rhoLR alice bob x y Q := by
  rw [oneRoundRoutingCanonicalGlobalChannel,
    FiniteKrausChannel.comp_action,
    FiniteKrausChannel.reindex_action,
    FiniteKrausChannel.comp_action,
    FiniteKrausChannel.comp_action,
    FiniteKrausChannel.reindex_action,
    FiniteKrausChannel.comp_action,
    FiniteKrausChannel.reindex_action,
    FiniteKrausChannel.appendFixedState_action,
    reindex_oneRoundRoutingResourceProductEquiv_kronecker]
  rfl

/-- Existence form: arbitrary mixed resource and local channels always induce
a global channel satisfying the raw model's realization equation. -/
theorem exists_oneRoundRoutingCanonicalGlobalChannel
    {X : Type uX} {Y : Type uY}
    {KA : Type uKA} {KB : Type uKB} [Fintype KA] [Fintype KB]
    {l r aKeep aToB bKeep bToA : ℕ}
    (rhoLR : DensityMatrix (l * r))
    (alice : X → FiniteKrausChannel KA (Fin 2 × Fin l)
      (Fin aKeep × Fin aToB))
    (bob : Y → FiniteKrausChannel KB (Fin r)
      (Fin bKeep × Fin bToA)) :
    ∃ global : X → Y → FiniteKrausChannel
        (OneRoundRoutingCanonicalGlobalKraus KA KB l r)
        (Fin 2)
        ((Fin aKeep × Fin bToA) × (Fin bKeep × Fin aToB)),
      ∀ x y Q, (global x y).action Q =
        oneRoundRoutingRealizedOutputMatrix rhoLR alice bob x y Q := by
  refine ⟨oneRoundRoutingCanonicalGlobalChannel rhoLR alice bob, ?_⟩
  exact oneRoundRoutingCanonicalGlobalChannel_action rhoLR alice bob

end LinearRouting
